{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": ["${python}", "-m", "uvicorn", "app.main:app", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": { "path": "/api/health", "expect_status": [200] },
      "env": {
        "DATABASE_URL": { "dev": "sqlite:///./wardrobe.db" },
        "CORS_ORIGIN": { "dev": "http://localhost:5173" },
        "UPLOAD_DIR": { "dev": "uploads" },
        "JWT_SECRET": { "generate": "hex", "bytes": 32 }
      }
    }
  ]
}
